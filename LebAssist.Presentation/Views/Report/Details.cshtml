@model LebAssist.Application.DTOs.ReportDto
@{
    ViewData["Title"] = $"Report #{Model.ReportId}";

    var statusColor = Model.Status switch
    {
        Domain.Enums.ReportStatus.Pending => "warning",
        Domain.Enums.ReportStatus.UnderReview => "info",
        Domain.Enums.ReportStatus.Resolved => "success",
        Domain.Enums.ReportStatus.Dismissed => "secondary",
        _ => "secondary"
    };

    var statusClass = Model.Status switch
    {
        Domain.Enums.ReportStatus.Pending => "status-pending",
        Domain.Enums.ReportStatus.UnderReview => "status-under-review",
        Domain.Enums.ReportStatus.Resolved => "status-resolved",
        Domain.Enums.ReportStatus.Dismissed => "status-dismissed",
        _ => "status-dismissed"
    };
}

<div class="report-details-page">
    <div class="container">
        <div class="report-detail-card @statusClass">
            <!-- Card Header -->
            <div class="card-header">
                <h3>
                    <i class="bi bi-file-earmark-text-fill"></i>
                    Report #@Model.ReportId
                </h3>
                <span class="badge bg-@statusColor">@Model.Status</span>
            </div>

            <!-- Card Body -->
            <div class="card-body">
                <!-- Reporter Info -->
                <div class="detail-section">
                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-label">Reporter</div>
                            <div class="detail-value">@Model.ReporterName</div>
                        </div>
                    </div>
                </div>

                <!-- Provider Info -->
                <div class="detail-section">
                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-label">Reported Provider</div>
                            <div class="detail-value">@Model.ProviderName</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ServiceName))
                    {
                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi bi-tools"></i>
                            </div>
                            <div class="detail-content">
                                <div class="detail-label">Service</div>
                                <div class="detail-value">@Model.ServiceName</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Report Details -->
                <div class="detail-section">
                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-exclamation-circle-fill"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-label">Reason</div>
                            <div class="detail-value">@Model.Reason</div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-label">Report Date</div>
                            <div class="detail-value">@Model.ReportDate.ToString("MMMM dd, yyyy 'at' h:mm tt")</div>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="detail-section">
                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-chat-left-text-fill"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-label">Description</div>
                            <div class="description-box">
                                <p>@Model.Description</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admin Response -->
                @if (!string.IsNullOrEmpty(Model.AdminNotes))
                {
                    <div class="admin-response">
                        <h5>
                            <i class="bi bi-chat-dots-fill"></i>
                            Admin Response
                        </h5>
                        <p>@Model.AdminNotes</p>
                    </div>
                }
            </div>

            <!-- Card Footer -->
            <div class="card-footer">
                <a asp-action="MyReports" class="btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back to Reports
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/reportDetails.css" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animate card on load
            const card = document.querySelector('.report-detail-card');
            if (card) {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, 100);
            }
        });
    </script>
}
