@model LebAssist.Presentation.ViewModels.Provider.ProviderDashboardViewModel
@{
    ViewData["Title"] = "Provider Dashboard";
}

<!-- Page Header -->
<div class="dashboard-header">
    <div class="container-fluid">
        <div class="header-content">
            <div>
                <h1 class="dashboard-title">
                    <i class="bi bi-speedometer2"></i>
                    Provider Dashboard
                </h1>
                <p class="dashboard-subtitle">Welcome back, @Model.ProviderName!</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline-primary" onclick="window.print()">
                    <i class="bi bi-printer"></i>
                    Print Report
                </button>
                <button class="btn btn-outline-primary" onclick="refreshDashboard()">
                    <i class="bi bi-arrow-clockwise"></i>
                    Refresh
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="container-fluid mt-4">
    <div class="row g-4">
        <!-- Total Revenue Card -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-success">
                <div class="stat-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="stat-details">
                    <h3 class="stat-value">$@Model.Stats.TotalRevenue.ToString("N2")</h3>
                    <p class="stat-label">Total Revenue</p>
                    <small class="stat-change @(Model.Stats.RevenueThisMonth > Model.Stats.RevenueLastMonth ? "text-success" : "text-danger")">
                        <i class="bi @(Model.Stats.RevenueThisMonth > Model.Stats.RevenueLastMonth ? "bi-arrow-up" : "bi-arrow-down")"></i>
                        $@Model.Stats.RevenueThisMonth.ToString("N2") this month
                    </small>
                </div>
            </div>
        </div>

        <!-- Total Bookings Card -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-primary">
                <div class="stat-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="stat-details">
                    <h3 class="stat-value">@Model.Stats.TotalBookings.ToString("N0")</h3>
                    <p class="stat-label">Total Bookings</p>
                    <small class="stat-change text-success">
                        <i class="bi bi-arrow-up"></i>
                        @Model.Stats.BookingsThisMonth this month
                    </small>
                </div>
            </div>
        </div>

        <!-- Completed Bookings Card -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-info">
                <div class="stat-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-details">
                    <h3 class="stat-value">@Model.Stats.CompletedBookings.ToString("N0")</h3>
                    <p class="stat-label">Completed Bookings</p>
                    <small class="stat-change">
                        $@Model.Stats.AverageRevenuePerBooking.ToString("N2") avg per booking
                    </small>
                </div>
            </div>
        </div>

        <!-- Average Rating Card -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-warning">
                <div class="stat-icon">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div class="stat-details">
                    <h3 class="stat-value">@Model.AverageRating.ToString("F1")</h3>
                    <p class="stat-label">Average Rating</p>
                    <small class="stat-change">
                        From @Model.TotalReviews.ToString("N0") reviews
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Stats Row -->
    <div class="row g-4 mt-2">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="mini-stat-card">
                <div class="mini-stat-icon bg-warning">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <h4>@Model.Stats.PendingBookings</h4>
                    <p>Pending</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="mini-stat-card">
                <div class="mini-stat-icon bg-info">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <h4>@Model.Stats.AcceptedBookings</h4>
                    <p>Active</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="mini-stat-card">
                <div class="mini-stat-icon bg-danger">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <h4>@Model.Stats.CancelledBookings</h4>
                    <p>Cancelled</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="mini-stat-card">
                <div class="mini-stat-icon bg-primary">
                    <i class="bi bi-tools"></i>
                </div>
                <div>
                    <h4>@Model.Stats.TotalServices</h4>
                    <p>Services</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="mini-stat-card">
                <div class="mini-stat-icon bg-success">
                    <i class="bi bi-check2-square"></i>
                </div>
                <div>
                    <h4>@Model.Stats.ActiveServices</h4>
                    <p>Active</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="mini-stat-card">
                <div class="mini-stat-icon bg-secondary">
                    <i class="bi bi-chat-square-text"></i>
                </div>
                <div>
                    <h4>@Model.Stats.NewReviewsThisMonth</h4>
                    <p>New Reviews</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 - Revenue Focus -->
    <div class="row g-4 mt-4">
        <!-- Revenue by Month Line Chart -->
        <div class="col-xl-8">
            <div class="chart-card">
                <div class="chart-header">
                    <h5 class="chart-title">
                        <i class="bi bi-graph-up"></i>
                        Revenue Trends (Last 12 Months)
                    </h5>
                    <div class="chart-legend">
                        <span class="legend-item">
                            <span class="legend-color" style="background: #1cc88a;"></span>
                            Monthly Revenue
                        </span>
                        <span class="legend-item">
                            <span class="legend-color" style="background: #4e73df;"></span>
                            Bookings
                        </span>
                    </div>
                </div>
                <div class="chart-body">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Booking Status Distribution Pie Chart -->
        <div class="col-xl-4">
            <div class="chart-card">
                <div class="chart-header">
                    <h5 class="chart-title">
                        <i class="bi bi-pie-chart"></i>
                        Booking Status
                    </h5>
                </div>
                <div class="chart-body">
                    <canvas id="statusDistributionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row g-4 mt-4">
        <!-- Booking Trends -->
        <div class="col-xl-6">
            <div class="chart-card">
                <div class="chart-header">
                    <h5 class="chart-title">
                        <i class="bi bi-bar-chart"></i>
                        Booking Trends (Last 6 Months)
                    </h5>
                </div>
                <div class="chart-body">
                    <canvas id="bookingTrendsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Service Revenue Bar Chart -->
        <div class="col-xl-6">
            <div class="chart-card">
                <div class="chart-header">
                    <h5 class="chart-title">
                        <i class="bi bi-currency-dollar"></i>
                        Revenue by Service
                    </h5>
                </div>
                <div class="chart-body">
                    <canvas id="serviceRevenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Row -->
    <div class="row g-4 mt-4">
        <!-- Service Performance Table -->
        <div class="col-xl-6">
            <div class="table-card">
                <div class="table-header">
                    <h5 class="table-title">
                        <i class="bi bi-trophy"></i>
                        Service Performance
                    </h5>
                </div>
                <div class="table-body">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Bookings</th>
                                <th>Completed</th>
                                <th>Revenue</th>
                                <th>Rating</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var service in Model.ServiceRevenue.Take(10))
                            {
                                <tr>
                                    <td>
                                        <strong>@service.ServiceName</strong>
                                        <br/>
                                        <small class="text-muted">@service.CategoryName</small>
                                    </td>
                                    <td>@service.BookingCount</td>
                                    <td><span class="badge bg-success">@service.CompletedBookings</span></td>
                                    <td><strong class="text-success">$@service.TotalRevenue.ToString("N2")</strong></td>
                                    <td>
                                        <span class="rating">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            @service.AverageRating.ToString("F1")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Bookings Table -->
        <div class="col-xl-6">
            <div class="table-card">
                <div class="table-header">
                    <h5 class="table-title">
                        <i class="bi bi-clock-history"></i>
                        Recent Bookings
                    </h5>
                </div>
                <div class="table-body">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Service</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td><strong>@booking.ClientName</strong></td>
                                    <td>@booking.ServiceName</td>
                                    <td>@booking.ScheduledDateTime.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @{
                                            var statusClass = booking.Status switch
                                            {
                                                "Completed" => "success",
                                                "Pending" => "warning",
                                                "Accepted" => "info",
                                                "InProgress" => "primary",
                                                _ => "danger"
                                            };
                                        }
                                        <span class="badge bg-@statusClass">@booking.Status</span>
                                    </td>
                                    <td>
                                        @if (booking.EstimatedRevenue > 0)
                                        {
                                            <strong class="text-success">$@booking.EstimatedRevenue.ToString("N2")</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Reviews Row -->
    @if (Model.RecentReviews.Any())
    {
        <div class="row g-4 mt-4">
            <div class="col-12">
                <div class="table-card">
                    <div class="table-header">
                        <h5 class="table-title">
                            <i class="bi bi-chat-left-quote"></i>
                            Recent Reviews
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            @foreach (var review in Model.RecentReviews.Take(3))
                            {
                                <div class="col-md-4">
                                    <div class="review-card">
                                        <div class="review-header">
                                            <div>
                                                <strong>@review.ClientName</strong>
                                                <br/>
                                                <small class="text-muted">@review.ServiceName</small>
                                            </div>
                                            <div class="review-rating">
                                                @for (int i = 0; i < review.Rating; i++)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                @for (int i = review.Rating; i < 5; i++)
                                                {
                                                    <i class="bi bi-star text-warning"></i>
                                                }
                                            </div>
                                        </div>
                                        <p class="review-comment">@review.Comment</p>
                                        <small class="text-muted">@review.ReviewDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a asp-controller="Provider" asp-action="MyReviews" class="btn btn-secondary">
                                <i class="bi bi-eye"></i>
                                View All Reviews
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/adminDashboard.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Chart.js configuration
        Chart.defaults.font.family = "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif";
        Chart.defaults.color = '#858796';

        // Revenue by Month Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.RevenueByMonth.Select(r => r.Month))),
                datasets: [
                    {
                        label: 'Revenue ($)',
                        data: @Html.Raw(Json.Serialize(Model.RevenueByMonth.Select(r => r.Revenue))),
                        borderColor: '#1cc88a',
                        backgroundColor: 'rgba(28, 200, 138, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Bookings',
                        data: @Html.Raw(Json.Serialize(Model.RevenueByMonth.Select(r => r.BookingCount))),
                        borderColor: '#4e73df',
                        backgroundColor: 'rgba(78, 115, 223, 0.1)',
                        borderWidth: 2,
                        fill: false,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        padding: 12,
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.parsed.y !== null) {
                                    if (context.datasetIndex === 0) {
                                        label += '$' + context.parsed.y.toFixed(2);
                                    } else {
                                        label += context.parsed.y;
                                    }
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0,0,0,0.05)'
                        },
                        ticks: {
                            callback: function(value) {
                                return '$' + value.toFixed(0);
                            }
                        },
                        title: {
                            display: true,
                            text: 'Revenue ($)'
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        beginAtZero: true,
                        grid: {
                            drawOnChartArea: false,
                        },
                        title: {
                            display: true,
                            text: 'Bookings'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        // Booking Status Distribution Pie Chart
        const statusDistCtx = document.getElementById('statusDistributionChart').getContext('2d');
        new Chart(statusDistCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.BookingStatusDistribution.Select(s => s.Status))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.BookingStatusDistribution.Select(s => s.Count))),
                    backgroundColor: [
                        '#f6c23e',
                        '#1cc88a',
                        '#4e73df',
                        '#e74a3b',
                        '#858796'
                    ],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            font: {
                                size: 12
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const label = context.label || '';
                                const value = context.parsed || 0;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((value / total) * 100).toFixed(1);
                                return `${label}: ${value} (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });

        // Booking Trends Bar Chart
        const bookingTrendsCtx = document.getElementById('bookingTrendsChart').getContext('2d');
        new Chart(bookingTrendsCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.BookingTrends.Select(b => b.Month))),
                datasets: [
                    {
                        label: 'Total Bookings',
                        data: @Html.Raw(Json.Serialize(Model.BookingTrends.Select(b => b.TotalBookings))),
                        backgroundColor: '#4e73df',
                        borderRadius: 8
                    },
                    {
                        label: 'Completed',
                        data: @Html.Raw(Json.Serialize(Model.BookingTrends.Select(b => b.CompletedBookings))),
                        backgroundColor: '#1cc88a',
                        borderRadius: 8
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0,0,0,0.05)'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        // Service Revenue Bar Chart
        const serviceRevenueCtx = document.getElementById('serviceRevenueChart').getContext('2d');
        new Chart(serviceRevenueCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ServiceRevenue.Take(5).Select(s => s.ServiceName))),
                datasets: [{
                    label: 'Revenue ($)',
                    data: @Html.Raw(Json.Serialize(Model.ServiceRevenue.Take(5).Select(s => s.TotalRevenue))),
                    backgroundColor: '#1cc88a',
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0,0,0,0.05)'
                        },
                        ticks: {
                            callback: function(value) {
                                return '$' + value.toFixed(0);
                            }
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        function refreshDashboard() {
            location.reload();
        }

        // Animation on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.stat-card, .mini-stat-card, .chart-card, .table-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 50);
            });
        });
    </script>
}
